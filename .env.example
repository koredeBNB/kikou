# Copy to .env.local and fill in any keys you have. Every assistant without a key
# answers with realistic demo text, so the app works with none of these set.

# Web search: off by default with a direct key below (set *_WEB_SEARCH=true to turn it on),
# on by default through OpenRouter (set *_WEB_SEARCH=false to turn it off).

# ChatGPT (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# With a direct key, web search needs a search model, e.g. OPENAI_MODEL=gpt-4o-mini-search-preview
# OPENAI_WEB_SEARCH=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# With a direct key, web search must be enabled for your Anthropic organisation.
# ANTHROPIC_WEB_SEARCH=

# Gemini (Google AI Studio). GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Grounds answers with Google Search and returns the cited sources.
# GEMINI_WEB_SEARCH=

# Perplexity (always searches the web and returns citations)
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# OpenRouter: one key for every assistant above that has no key of its own,
# and the preferred model for drafting the brief, reading replies and writing questions.
OPENROUTER_API_KEY=
# OPENROUTER_CHATGPT_MODEL=openai/gpt-6-luna
# OPENROUTER_CLAUDE_MODEL=anthropic/claude-haiku-5.5
# OPENROUTER_GEMINI_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar
# OPENROUTER_INTAKE_MODEL=google/gemini-3.5-flash-lite
# Reasoning effort for the intake model: none, minimal, low, medium or high.
# Defaults to low for Gemini 3.5 Flash Lite, which can't switch it off, and none for a model set above.
# OPENROUTER_INTAKE_REASONING=low
# Set to false to never look unfamiliar brands up on the web (about a cent each, booked to the daily cap).
# SOV_INTAKE_WEB_LOOKUP=true
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Intake model when there's no OpenRouter key: the first direct key above is used.
# OPENAI_INTAKE_MODEL=gpt-4.1-nano
# ANTHROPIC_INTAKE_MODEL=claude-haiku-4-5
# GEMINI_INTAKE_MODEL=gemini-2.5-flash-lite
# Set to true to always ask step by step and read replies with the built-in rules.
# SOV_INTAKE_RULES=false
# How long to wait for the intake model before using the rules (milliseconds, at most 8000).
# SOV_INTAKE_TIMEOUT_MS=6000

# Set to true to ignore every key above: demo answers and rule-based intake.
# SOV_FORCE_MOCK=false

# Set both to require a password for every page and API route (HTTP basic auth).
# SOV_BASIC_AUTH_USER=
# SOV_BASIC_AUTH_PASSWORD=
# Spending cap per UTC day in US dollars, for everyone together. Defaults to 20; "off" removes it.
# SOV_MAX_SPEND_PER_DAY=20
# Checks each visitor (IP address) can start per hour. Defaults to 12; "off" removes every per-visitor limit.
# SOV_CHECKS_PER_HOUR=12

# Redis for run state, the daily budget and rate limits. Required on Vercel; locally an in-process store is used
# when these are empty. The Vercel Marketplace's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
